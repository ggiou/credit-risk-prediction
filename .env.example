DB_HOST=mysql
DB_PORT=3306
DB_NAME=credit_risk
DB_USERNAME=spring_app
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_SSL_MODE=DISABLED

AI_SERVER_BASE_URL=http://ai-server:8000
AI_MODEL_VERSION=miribom-lgbm-v0.3
AI_FEATURE_SCHEMA_VERSION=v1
AI_PROMPT_VERSION=v3.6
BATCH_AI_CONCURRENCY=2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_PROMPT_CACHE_ENABLED=true
OPENAI_PROMPT_CACHE_MODE=explicit
OPENAI_PROMPT_CACHE_TTL=30m
OPENAI_PROMPT_CACHE_KEY_PREFIX=miribom-risk-explanation
AI_LLM_TIMEOUT_SECONDS=60
AI_READ_TIMEOUT_SECONDS=75
